# Salin nilai ini ke konfigurasi environment platform deployment Anda.
# Aplikasi tidak memuat file .env sendiri; gunakan environment variables platform,
# PowerShell, atau service manager untuk mengaturnya.

# Lokasi penyimpanan data persisten. Kosongkan untuk memakai ./data di repository.
MCSA_DATA_DIR=

# Jumlah backup mcsa_updated.csv yang dipertahankan (minimum 1).
MCSA_MAX_BACKUPS=10

# Opsional: file JSON untuk penyimpanan Work Order runtime.
# Kosongkan untuk memakai data runtime lokal.
WORK_ORDERS_FILE=

# Base URL backend FastAPI untuk frontend React/Vite.
VITE_API_BASE_URL=http://localhost:8000

# Nama yang dicatat sebagai WHO di audit log (pple/core/audit.py). Kosong =
# memakai user OS. Belum ada login, jadi ini petunjuk, bukan bukti otentikasi.
PPLE_ACTOR=

# Keamanan API FastAPI.
# PPLE_API_KEY kosong = server terbuka (hanya aman untuk localhost). Diisi =
# semua endpoint kecuali /api/health wajib membawa header X-API-Key
# (atau Authorization: Bearer <key>).
PPLE_API_KEY=

# Origin yang boleh memanggil API dari browser, dipisah koma. Kosong = hanya
# localhost (Vite 5173 / Streamlit 8501 / FastAPI 8000). Isi dengan domain
# produksi, mis. https://pdm.contoh.co.id
PPLE_CORS_ORIGINS=

# API key yang dikirim frontend React bila PPLE_API_KEY diaktifkan.
# Nilainya harus sama dengan PPLE_API_KEY di backend.
VITE_API_KEY=

# Opsional: aktifkan fitur AI. Jangan commit nilai API key sebenarnya.
GEMINI_API_KEY=

# pple/database/ (docs/final.md Phase 2-4). Project Supabase - lihat
# CLAUDE.md untuk status migrasi. Kosongkan/hapus baris ini bila belum
# memakai database terpusat.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
