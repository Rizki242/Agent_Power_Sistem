# Line-ending policy for this repo.
#
# Default is "do nothing": unknown/unlisted file types are left exactly as
# they are on disk and in the index. We do NOT use `* text=auto`, because
# git's own text/binary heuristic already mis-detected some plain-ASCII PDFs
# in this repo as text and let CRLF conversion corrupt them (see git history
# around the chore/normalize-line-endings commit). Everything binary must be
# declared explicitly below instead of relying on autodetection.
* -text

# --- Source code & config: normalize to LF, no matter which OS commits ---
*.py            text eol=lf
*.js            text eol=lf
*.jsx            text eol=lf
*.ts             text eol=lf
*.tsx            text eol=lf
*.json           text eol=lf
*.md             text eol=lf
*.yaml           text eol=lf
*.yml            text eol=lf
*.toml           text eol=lf
*.ini            text eol=lf
*.cfg            text eol=lf
*.css            text eol=lf
*.csv            text eol=lf
*.txt            text eol=lf
*.html           text eol=lf
*.htm            text eol=lf
*.svg            text eol=lf
*.sh             text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf
.env.example     text eol=lf
*.example        text eol=lf

# --- Windows batch scripts: keep native CRLF (this is a Windows-first repo) ---
*.bat            text eol=crlf

# --- Explicit binary: never diff as text, never convert line endings ---
*.pdf   binary
*.doc   binary
*.docx  binary
*.docm  binary
*.xls   binary
*.xlsx  binary
*.ppt   binary
*.pptx  binary
*.sqlite  binary
*.sqlite3 binary
*.db    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.sys   binary
*.swf   binary
*.mp4   binary
*.lib   binary
*.dat   binary
