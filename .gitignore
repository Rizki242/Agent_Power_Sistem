# Preferensi LLM per-pengguna (provider/model pilihan, tanpa API key).
# Ditulis ulang oleh halaman Settings, jadi bukan config bersama.
data/MCSA/config/ai_settings.json

# Scratch archives (mis. unduhan tooling) - jangan pernah masuk repo
archive-*/

# Audit log runtime (data per-deployment, lihat pple/core/audit.py).
# get_data_path() bisa menaruhnya di data/ atau data/MCSA/.
data/**/audit/
data/audit/

# Runtime state yang ditulis ulang otomatis (memori chatbot, continuous
# learning) - bukan source of truth, jangan di-commit.
data/agent_memory.db
data/learning/improvement_history.json
data/learning/improvement_state.json

# Artefak sisa scratch/testing lokal, bukan bagian repo.
.tmp-test-runtime/
.tmp-npm-cache/
.venv-linux-backup/
scripts/scratch/
